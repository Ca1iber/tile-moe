+        def shared_16x32_to_local_64x8_layout_a(i, j):
+            thread_id = i + 16 * (j // 8)
+            local_id = j % 8
+            return thread_id, local_id
+
+        def thread_id_shared_access_64x8_to_16x32_layout_a(thread_id, local_id):
+            i = thread_id % 16
+            j = (thread_id // 16) * 8 + local_id
+            return i, j
